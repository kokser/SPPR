      <toolTip>
        <key>ru</key>
        <value>В патч будут включены все коммиты, комментарий к которым содержит номер ошибки</value>
      </toolTip>
      <toolTipRepresentation>ShowBottom</toolTipRepresentation>
      <handlers>
        <event>OnChange</event>
