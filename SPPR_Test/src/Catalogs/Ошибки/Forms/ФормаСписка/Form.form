    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.СрочностьИсправления</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Статус</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СправочникОшибки.Ссылка КАК Ссылка,
	СправочникОшибки.ПометкаУдаления КАК ПометкаУдаления,
	СправочникОшибки.Код КАК Код,
	СправочникОшибки.Наименование КАК Наименование,
	СправочникОшибки.Владелец КАК Владелец,
	СправочникОшибки.Основание КАК Основание,
	СправочникОшибки.Статус КАК Статус,
	СправочникОшибки.ДатаСоздания КАК ДатаСоздания,
	СправочникОшибки.ДатаРегистрации КАК ДатаРегистрации,
	СправочникОшибки.Автор КАК Автор,
	СправочникОшибки.Зарегистрировал КАК Зарегистрировал,
	СправочникОшибки.ВерсияПлатформы КАК ВерсияПлатформы,
	СправочникОшибки.СборкаОбнаружения КАК СборкаОбнаружения,
	СправочникОшибки.ВеткаОбнаружения КАК ВеткаОбнаружения,
	СправочникОшибки.ДатаОбнаружения КАК ДатаОбнаружения,
	СправочникОшибки.Обнаружена КАК МестоОбнаружения,
	ВЫБОР
		КОГДА СправочникОшибки.Обнаружена = ЗНАЧЕНИЕ(Перечисление.МестаОбнаруженияОшибок.ВСборке)
			ТОГДА СправочникОшибки.СборкаОбнаружения
		КОГДА СправочникОшибки.Обнаружена = ЗНАЧЕНИЕ(Перечисление.МестаОбнаруженияОшибок.ВВетке)
			ТОГДА СправочникОшибки.ВеткаОбнаружения
	КОНЕЦ КАК Обнаружена,
	СправочникОшибки.ИнформационнаяБазаДляВоспроизведения КАК ИнформационнаяБазаДляВоспроизведения,
	СправочникОшибки.Клиент КАК Клиент,
	СправочникОшибки.СУБД КАК СУБД,
	ВЫРАЗИТЬ(СправочникОшибки.ПорядокВоспроизведения КАК СТРОКА(1000)) КАК ПорядокВоспроизведения,
	СправочникОшибки.КомуНаправлена КАК КомуНаправлена,
	СправочникОшибки.ДатаНаправления КАК ДатаНаправления,
	СправочникОшибки.ДатаРассмотрения КАК ДатаРассмотрения,
	СправочникОшибки.Рассмотрел КАК Рассмотрел,
	СправочникОшибки.СрочностьИсправления КАК СрочностьИсправления,
	ВЫРАЗИТЬ(СправочникОшибки.ОписаниеИзменений КАК СТРОКА(1000)) КАК ОписаниеИзменений,
	ВЫРАЗИТЬ(СправочникОшибки.СпособОбхода КАК СТРОКА(1000)) КАК СпособОбхода,
	СправочникОшибки.ДатаИсправления КАК ДатаИсправления,
	СправочникОшибки.Исправил КАК Исправил,
	СправочникОшибки.Исправляется КАК Исправляется,
	СправочникОшибки.ВерсияИсправления КАК ВерсияИсправления,
	СправочникОшибки.ВеткаИсправления КАК ВеткаИсправления,
	СправочникОшибки.ДатаПроверки КАК ДатаПроверки,
	СправочникОшибки.Проверил КАК Проверил,
	СправочникОшибки.ДатаОтзыва КАК ДатаОтзыва,
	СправочникОшибки.Отозвал КАК Отозвал,
	СправочникОшибки.ДатаЗакрытия КАК ДатаЗакрытия,
	СправочникОшибки.Закрыл КАК Закрыл,
	СправочникОшибки.НеПланируетИсправлять КАК НеПланируетИсправлять,
	СправочникОшибки.УстановилОжидаетИсправленияПовторяемой КАК УстановилОжидаетИсправленияПовторяемой,
	СправочникОшибки.Зарегистрирована КАК Зарегистрирована,
	СправочникОшибки.Признана КАК Признана,
	СправочникОшибки.НеПризнана КАК НеПризнана,
	СправочникОшибки.Исправлена КАК Исправлена,
	СправочникОшибки.Проверена КАК Проверена,
	СправочникОшибки.Отозвана КАК Отозвана,
	СправочникОшибки.Закрыта КАК Закрыта,
	СправочникОшибки.СрокОтработки КАК СрокОтработки,
	СправочникОшибки.ПовторяемаяОшибка КАК ПовторяемаяОшибка,
	ВЫРАЗИТЬ(СправочникОшибки.ПричиныНепризнания КАК СТРОКА(1000)) КАК ПричиныНепризнания,
	СправочникОшибки.ЕстьИзмененияПоСравнениюСРанееПринятымиПроектнымиРешениями КАК ЕстьИзмененияПоСравнениюСРанееПринятымиПроектнымиРешениями,
	СправочникОшибки.ОшибкаЗарегистрированаПоИнформацииОтВнешнихИсточников КАК ОшибкаЗарегистрированаПоИнформацииОтВнешнихИсточников,
	СправочникОшибки.МетодВыявленияОшибки КАК МетодВыявленияОшибки,
	СправочникОшибки.РазделПроекта КАК РазделПроекта,
	Проекты.ИспользоватьЗакрытиеОшибок КАК ИспользуетсяЗакрытиеОшибок,
	ВЫБОР
		КОГДА Проекты.ИспользоватьЗакрытиеОшибок
					И НЕ Проекты.ИспользоватьЗакрытиеТолькоДляОшибокСПроектнымиИзменениями
				ИЛИ Проекты.ИспользоватьЗакрытиеТолькоДляОшибокСПроектнымиИзменениями
					И СправочникОшибки.ЕстьИзмененияПоСравнениюСРанееПринятымиПроектнымиРешениями
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ОшибкаПодлежитЗакрытию,
	СправочникОшибки.СтатусПубликации КАК СтатусПубликации,
	СправочникОшибки.ДатаПервойПубликации КАК ДатаПервойПубликации,
	СправочникОшибки.ДатаИзмененияПубликации КАК ДатаИзмененияПубликации,
	ВЫРАЗИТЬ(СправочникОшибки.ПубликуемоеОписание КАК СТРОКА(1000)) КАК ПубликуемоеОписание,
	ВЫРАЗИТЬ(СправочникОшибки.ИсходнаяИнформацияОбОшибке КАК СТРОКА(1000)) КАК ИсходнаяИнформацияОбОшибке,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ КАК ИндексКартинки,
	ВЫБОР
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.НеЗарегистрирована)
			ТОГДА &quot;Зарегистрировать&quot;
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Зарегистрирована)
			ТОГДА &quot;Признать&quot;
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Признана)
			ТОГДА &quot;Исправить&quot;
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.НеПризнана)
			ТОГДА &quot;Отозвать&quot;
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Исправлена)
			ТОГДА &quot;Подтвердить исправление&quot;
		КОГДА (СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.ПроверенаИсправлена)
				ИЛИ СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Отозвана))
				И Проекты.ИспользоватьЗакрытиеОшибок
				И (НЕ Проекты.ИспользоватьЗакрытиеТолькоДляОшибокСПроектнымиИзменениями
					ИЛИ Проекты.ИспользоватьЗакрытиеТолькоДляОшибокСПроектнымиИзменениями
						И СправочникОшибки.ЕстьИзмененияПоСравнениюСРанееПринятымиПроектнымиРешениями)
			ТОГДА &quot;Закрыть&quot;
		ИНАЧЕ &quot;&quot;
	КОНЕЦ КАК ДействияСОшибкой,
	ВЫБОР
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.НеЗарегистрирована)
			ТОГДА 0
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Зарегистрирована)
			ТОГДА 1
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Признана)
			ТОГДА 2
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Отозвана)
			ТОГДА 3
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Исправлена)
			ТОГДА 4
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.ПроверенаИсправлена)
			ТОГДА 5
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.НеПризнана)
			ТОГДА 6
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Закрыта)
			ТОГДА 8
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.НеПланируетсяИсправлять)
			ТОГДА 9
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.ОжидаетИсправленияПовторяемойОшибки)
			ТОГДА 10
		ИНАЧЕ 1000
	КОНЕЦ КАК ИндексКартинкиСтатуса,
	ВЫБОР
		КОГДА СправочникОшибки.СрочностьИсправления = ЗНАЧЕНИЕ(Перечисление.СрочностьИсправленияОшибок.ВПлановомПорядке)
			ТОГДА 0
		КОГДА СправочникОшибки.СрочностьИсправления = ЗНАЧЕНИЕ(Перечисление.СрочностьИсправленияОшибок.ЖелательноБыстрее)
			ТОГДА 1
		КОГДА СправочникОшибки.СрочностьИсправления = ЗНАЧЕНИЕ(Перечисление.СрочностьИсправленияОшибок.Немедленно)
			ТОГДА 2
	КОНЕЦ КАК ИндексКартинкиСрочностиИсправления,
	ВЫРАЗИТЬ(СправочникОшибки.СпособИсправления КАК СТРОКА(1000)) КАК СпособИсправления,
	ВЫРАЗИТЬ(СправочникОшибки.ТекстПоследнегоПоручения КАК СТРОКА(1000)) КАК ТекстПоследнегоПоручения,
	Пользователи.Подразделение КАК ПодразделениеКомуНаправлена,
	ВеткиОбнаружения.Тип КАК ТипВеткиОбнаружения,
	СборкиОбнаружения.Владелец КАК ВерсияОбнаружения,
	ПользователиАвтор.Подразделение КАК АвторПодразделение,
	ПользователиЗарегистрировал.Подразделение КАК ЗарегистрировалПодразделение,
	ПользователиРассмотрел.Подразделение КАК РассмотрелПодразделение,
	ПользователиИсправил.Подразделение КАК ИсправилПодразделение,
	ПользователиПроверил.Подразделение КАК ПроверилПодразделение,
	ПользователиЗакрыл.Подразделение КАК ЗакрылПодразделение,
	ПользователиОтозвал.Подразделение КАК ОтозвалПодразделение,
	ПользователиНеПланируетИсправлять.Подразделение КАК НеПланируетИсправлятьПодразделение,
	ПользователиУстановилОжидаетИсправленияПовторяемой.Подразделение КАК УстановилОжидаетИсправленияПовторяемойПодразделение
ИЗ
	Справочник.Ошибки КАК СправочникОшибки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
		ПО (НаличиеФайлов.ОбъектСФайлами = СправочникОшибки.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
		ПО СправочникОшибки.КомуНаправлена = Пользователи.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Ветки КАК ВеткиОбнаружения
		ПО СправочникОшибки.ВеткаОбнаружения = ВеткиОбнаружения.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СборкиВерсии КАК СборкиОбнаружения
		ПО СправочникОшибки.СборкаОбнаружения = СборкиОбнаружения.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Проекты КАК Проекты
		ПО СправочникОшибки.Владелец = Проекты.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ПользователиАвтор
		ПО (СправочникОшибки.Автор = ПользователиАвтор.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ПользователиЗарегистрировал
		ПО (СправочникОшибки.Зарегистрировал = ПользователиЗарегистрировал.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ПользователиРассмотрел
		ПО (СправочникОшибки.Рассмотрел = ПользователиРассмотрел.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ПользователиИсправил
		ПО (СправочникОшибки.Исправил = ПользователиИсправил.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ПользователиПроверил
		ПО (СправочникОшибки.Проверил = ПользователиПроверил.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ПользователиЗакрыл
		ПО (СправочникОшибки.Закрыл = ПользователиЗакрыл.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ПользователиОтозвал
		ПО (СправочникОшибки.Отозвал = ПользователиОтозвал.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ПользователиНеПланируетИсправлять
		ПО (СправочникОшибки.НеПланируетИсправлять = ПользователиНеПланируетИсправлять.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ПользователиУстановилОжидаетИсправленияПовторяемой
		ПО (СправочникОшибки.УстановилОжидаетИсправленияПовторяемой = ПользователиУстановилОжидаетИсправленияПовторяемой.Ссылка)</queryText>
