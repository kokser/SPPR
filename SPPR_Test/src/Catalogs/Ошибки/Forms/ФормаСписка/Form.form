  <attributes>
    <name>СписокОшибокВВетках</name>
    <title>
      <key>ru</key>
      <value>Список ошибок в ветках</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокОшибокВВетках.Версия</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокОшибокВВетках.ИспользуетсяЗакрытиеОшибок</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокОшибокВВетках.ПорядковыйНомерВерсии</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокОшибокВВетках.Ветка</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокОшибокВВетках.КомуНаправлена</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокОшибокВВетках.СостояниеИсправления</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокОшибокВВетках.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокОшибокВВетках.Статус</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СправочникОшибки.Ссылка КАК Ссылка,
	СправочникОшибки.ПометкаУдаления КАК ПометкаУдаления,
	СправочникОшибки.Код КАК Код,
	СправочникОшибки.Наименование КАК Наименование,
	СправочникОшибки.Владелец КАК Владелец,
	СправочникОшибки.Основание КАК Основание,
	СправочникОшибки.Статус КАК Статус,
	СправочникОшибки.ДатаСоздания КАК ДатаСоздания,
	СправочникОшибки.ДатаРегистрации КАК ДатаРегистрации,
	СправочникОшибки.Автор КАК Автор,
	СправочникОшибки.Зарегистрировал КАК Зарегистрировал,
	СправочникОшибки.ВерсияПлатформы КАК ВерсияПлатформы,
	СправочникОшибки.СборкаОбнаружения КАК СборкаОбнаружения,
	СправочникОшибки.ДатаОбнаружения КАК ДатаОбнаружения,
	СправочникОшибки.Обнаружена КАК МестоОбнаружения,
	ВЫБОР
		КОГДА СправочникОшибки.Обнаружена = ЗНАЧЕНИЕ(Перечисление.МестаОбнаруженияОшибок.ВСборке)
			ТОГДА СправочникОшибки.СборкаОбнаружения
		КОГДА СправочникОшибки.Обнаружена = ЗНАЧЕНИЕ(Перечисление.МестаОбнаруженияОшибок.ВВетке)
			ТОГДА СправочникОшибки.ВеткаОбнаружения
	КОНЕЦ КАК Обнаружена,
	СправочникОшибки.ИнформационнаяБазаДляВоспроизведения КАК ИнформационнаяБазаДляВоспроизведения,
	СправочникОшибки.Клиент КАК Клиент,
	СправочникОшибки.СУБД КАК СУБД,
	ВЫРАЗИТЬ(СправочникОшибки.ПорядокВоспроизведения КАК СТРОКА(1000)) КАК ПорядокВоспроизведения,
	СправочникОшибки.КомуНаправлена КАК КомуНаправлена,
	СправочникОшибки.ДатаНаправления КАК ДатаНаправления,
	СправочникОшибки.ДатаРассмотрения КАК ДатаРассмотрения,
	СправочникОшибки.Рассмотрел КАК Рассмотрел,
	СправочникОшибки.СрочностьИсправления КАК СрочностьИсправления,
	ВЫРАЗИТЬ(СправочникОшибки.ОписаниеИзменений КАК СТРОКА(1000)) КАК ОписаниеИзменений,
	ВЫРАЗИТЬ(СправочникОшибки.СпособОбхода КАК СТРОКА(1000)) КАК СпособОбхода,
	СправочникОшибки.ДатаИсправления КАК ДатаИсправления,
	СправочникОшибки.Исправил КАК Исправил,
	СправочникОшибки.Исправляется КАК Исправляется,
	СправочникОшибки.ВерсияИсправления КАК ВерсияИсправления,
	СправочникОшибки.ДатаПроверки КАК ДатаПроверки,
	СправочникОшибки.Проверил КАК Проверил,
	СправочникОшибки.ДатаОтзыва КАК ДатаОтзыва,
	СправочникОшибки.Отозвал КАК Отозвал,
	СправочникОшибки.ДатаЗакрытия КАК ДатаЗакрытия,
	СправочникОшибки.Закрыл КАК Закрыл,
	СправочникОшибки.Зарегистрирована КАК Зарегистрирована,
	СправочникОшибки.Признана КАК Признана,
	СправочникОшибки.НеПризнана КАК НеПризнана,
	СправочникОшибки.Исправлена КАК Исправлена,
	СправочникОшибки.Проверена КАК Проверена,
	СправочникОшибки.Отозвана КАК Отозвана,
	СправочникОшибки.Закрыта КАК Закрыта,
	СправочникОшибки.СрокОтработки КАК СрокОтработки,
	СправочникОшибки.ПовторяемаяОшибка КАК ПовторяемаяОшибка,
	ВЫРАЗИТЬ(СправочникОшибки.ПричиныНепризнания КАК СТРОКА(1000)) КАК ПричиныНепризнания,
	СправочникОшибки.ЕстьИзмененияПоСравнениюСРанееПринятымиПроектнымиРешениями КАК ЕстьИзмененияПоСравнениюСРанееПринятымиПроектнымиРешениями,
	СправочникОшибки.ОшибкаЗарегистрированаПоИнформацииОтВнешнихИсточников КАК ОшибкаЗарегистрированаПоИнформацииОтВнешнихИсточников,
	СправочникОшибки.РазделПроекта КАК РазделПроекта,
	СправочникОшибки.СтатусПубликации КАК СтатусПубликации,
	СправочникОшибки.ДатаПервойПубликации КАК ДатаПервойПубликации,
	СправочникОшибки.ДатаИзмененияПубликации КАК ДатаИзмененияПубликации,
	ВЫРАЗИТЬ(СправочникОшибки.ПубликуемоеОписание КАК СТРОКА(1000)) КАК ПубликуемоеОписание,
	ВЫРАЗИТЬ(СправочникОшибки.ИсходнаяИнформацияОбОшибке КАК СТРОКА(1000)) КАК ИсходнаяИнформацияОбОшибке,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ КАК ИндексКартинки,
	ВЫБОР
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.НеЗарегистрирована)
			ТОГДА 0
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Зарегистрирована)
			ТОГДА 1
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Признана)
			ТОГДА 2
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Отозвана)
			ТОГДА 3
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Исправлена)
			ТОГДА 4
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.ПроверенаИсправлена)
			ТОГДА 5
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.НеПризнана)
			ТОГДА 6
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Закрыта)
			ТОГДА 8
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.НеПланируетсяИсправлять)
			ТОГДА 9
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.ОжидаетИсправленияПовторяемойОшибки)
			ТОГДА 10
		ИНАЧЕ 1000
	КОНЕЦ КАК ИндексКартинкиСтатуса,
	ВЫБОР
		КОГДА СправочникОшибки.СрочностьИсправления = ЗНАЧЕНИЕ(Перечисление.СрочностьИсправленияОшибок.ВПлановомПорядке)
			ТОГДА 0
		КОГДА СправочникОшибки.СрочностьИсправления = ЗНАЧЕНИЕ(Перечисление.СрочностьИсправленияОшибок.ЖелательноБыстрее)
			ТОГДА 1
		КОГДА СправочникОшибки.СрочностьИсправления = ЗНАЧЕНИЕ(Перечисление.СрочностьИсправленияОшибок.Немедленно)
			ТОГДА 2
	КОНЕЦ КАК ИндексКартинкиСрочностиИсправления,
	ВЫРАЗИТЬ(СправочникОшибки.СпособИсправления КАК СТРОКА(1000)) КАК СпособИсправления,
	ВЫРАЗИТЬ(СправочникОшибки.ТекстПоследнегоПоручения КАК СТРОКА(1000)) КАК ТекстПоследнегоПоручения,
	ВЫБОР
		КОГДА СправочникОшибки.Обнаружена = ЗНАЧЕНИЕ(Перечисление.МестаОбнаруженияОшибок.ВСборке)
			ТОГДА Сборки.Ветка
		КОГДА СправочникОшибки.Обнаружена = ЗНАЧЕНИЕ(Перечисление.МестаОбнаруженияОшибок.ВВетке)
			ТОГДА СправочникОшибки.ВеткаОбнаружения
	КОНЕЦ КАК ВеткаОбнаружения,
	ОшибкиИсправлениеВВетках.Ветка КАК Ветка,
	ОшибкиИсправлениеВВетках.ДатаПривнесения КАК Привнесена,
	ОшибкиИсправлениеВВетках.ВеткаИсправления КАК ВеткаИсправления,
	ВЫБОР
		КОГДА (СправочникОшибки.НеПризнана
				ИЛИ СправочникОшибки.Отозвана)
				И ОшибкиИсправлениеВВетках.СостояниеИсправления &lt;> ЗНАЧЕНИЕ(Перечисление.СостоянияИсправленияОшибок.ИсправлениеНеПланируется)
				И ОшибкиИсправлениеВВетках.СостояниеИсправления &lt;> ЗНАЧЕНИЕ(Перечисление.СостоянияИсправленияОшибок.ОшибкиНеБылоВЭтойВетке)
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияИсправленияОшибок.ОшибкиНеБылоВЭтойВетке)
		ИНАЧЕ ОшибкиИсправлениеВВетках.СостояниеИсправления
	КОНЕЦ КАК СостояниеИсправления,
	ОшибкиИсправлениеВВетках.ДатаИсправления КАК ДатаИсправленияВВетке,
	ЕСТЬNULL(ВеткиИсправления.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыВеток.ПустаяСсылка)) КАК СтатусВеткиИсправления,
	ОтветственныеЗаИсправительныеВетки.Ссылка КАК ОтветственныйЗаВеткуИсправления,
	ОтветственныеЗаИсправительныеВетки.Подразделение КАК ПодразделениеОтветственноеЗаВеткуИсправления
ИЗ
	Справочник.Ошибки КАК СправочникОшибки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
		ПО (НаличиеФайлов.ОбъектСФайлами = СправочникОшибки.Ссылка)
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Ошибки.ИсправлениеВВетках КАК ОшибкиИсправлениеВВетках
		ПО СправочникОшибки.Ссылка = ОшибкиИсправлениеВВетках.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СборкиВерсии КАК Сборки
		ПО (СправочникОшибки.Обнаружена = ЗНАЧЕНИЕ(Перечисление.МестаОбнаруженияОшибок.ВСборке))
			И СправочникОшибки.СборкаОбнаружения = Сборки.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Ветки КАК ВеткиИсправления
		ПО (ОшибкиИсправлениеВВетках.ВеткаИсправления = ВеткиИсправления.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ОтветственныеЗаИсправительныеВетки
		ПО (ВеткиИсправления.Ответственный = ОтветственныеЗаИсправительныеВетки.Ссылка)
ГДЕ
	СправочникОшибки.Исправляется = ЗНАЧЕНИЕ(Перечисление.ВариантыИсправленияОшибок.ВРазныхВетках)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СправочникОшибки.Ссылка,
	СправочникОшибки.ПометкаУдаления,
	СправочникОшибки.Код,
	СправочникОшибки.Наименование,
	СправочникОшибки.Владелец,
	СправочникОшибки.Основание,
	СправочникОшибки.Статус,
	СправочникОшибки.ДатаСоздания,
	СправочникОшибки.ДатаРегистрации,
	СправочникОшибки.Автор,
	СправочникОшибки.Зарегистрировал,
	СправочникОшибки.ВерсияПлатформы,
	СправочникОшибки.СборкаОбнаружения,
	СправочникОшибки.ДатаОбнаружения,
	СправочникОшибки.Обнаружена,
	ВЫБОР
		КОГДА СправочникОшибки.Обнаружена = ЗНАЧЕНИЕ(Перечисление.МестаОбнаруженияОшибок.ВСборке)
			ТОГДА СправочникОшибки.СборкаОбнаружения
		КОГДА СправочникОшибки.Обнаружена = ЗНАЧЕНИЕ(Перечисление.МестаОбнаруженияОшибок.ВВетке)
			ТОГДА СправочникОшибки.ВеткаОбнаружения
	КОНЕЦ,
	СправочникОшибки.ИнформационнаяБазаДляВоспроизведения,
	СправочникОшибки.Клиент,
	СправочникОшибки.СУБД,
	ВЫРАЗИТЬ(СправочникОшибки.ПорядокВоспроизведения КАК СТРОКА(1000)),
	СправочникОшибки.КомуНаправлена,
	СправочникОшибки.ДатаНаправления,
	СправочникОшибки.ДатаРассмотрения,
	СправочникОшибки.Рассмотрел,
	СправочникОшибки.СрочностьИсправления,
	ВЫРАЗИТЬ(СправочникОшибки.ОписаниеИзменений КАК СТРОКА(1000)),
	ВЫРАЗИТЬ(СправочникОшибки.СпособОбхода КАК СТРОКА(1000)),
	СправочникОшибки.ДатаИсправления,
	СправочникОшибки.Исправил,
	СправочникОшибки.Исправляется,
	СправочникОшибки.ВерсияИсправления,
	СправочникОшибки.ДатаПроверки,
	СправочникОшибки.Проверил,
	СправочникОшибки.ДатаОтзыва,
	СправочникОшибки.Отозвал,
	СправочникОшибки.ДатаЗакрытия,
	СправочникОшибки.Закрыл,
	СправочникОшибки.Зарегистрирована,
	СправочникОшибки.Признана,
	СправочникОшибки.НеПризнана,
	СправочникОшибки.Исправлена,
	СправочникОшибки.Проверена,
	СправочникОшибки.Отозвана,
	СправочникОшибки.Закрыта,
	СправочникОшибки.СрокОтработки,
	СправочникОшибки.ПовторяемаяОшибка,
	ВЫРАЗИТЬ(СправочникОшибки.ПричиныНепризнания КАК СТРОКА(1000)),
	СправочникОшибки.ЕстьИзмененияПоСравнениюСРанееПринятымиПроектнымиРешениями,
	СправочникОшибки.ОшибкаЗарегистрированаПоИнформацииОтВнешнихИсточников,
	СправочникОшибки.РазделПроекта,
	СправочникОшибки.СтатусПубликации,
	СправочникОшибки.ДатаПервойПубликации,
	СправочникОшибки.ДатаИзмененияПубликации,
	ВЫРАЗИТЬ(СправочникОшибки.ПубликуемоеОписание КАК СТРОКА(1000)),
	ВЫРАЗИТЬ(СправочникОшибки.ИсходнаяИнформацияОбОшибке КАК СТРОКА(1000)),
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 0
		ИНАЧЕ 1
	КОНЕЦ,
	ВЫБОР
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.НеЗарегистрирована)
			ТОГДА 0
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Зарегистрирована)
			ТОГДА 1
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Признана)
			ТОГДА 2
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Отозвана)
			ТОГДА 3
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Исправлена)
			ТОГДА 4
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.ПроверенаИсправлена)
			ТОГДА 5
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.НеПризнана)
			ТОГДА 6
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.Закрыта)
			ТОГДА 8
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.НеПланируетсяИсправлять)
			ТОГДА 9
		КОГДА СправочникОшибки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыОшибок.ОжидаетИсправленияПовторяемойОшибки)
			ТОГДА 10
		ИНАЧЕ 1000
	КОНЕЦ,
	ВЫБОР
		КОГДА СправочникОшибки.СрочностьИсправления = ЗНАЧЕНИЕ(Перечисление.СрочностьИсправленияОшибок.ВПлановомПорядке)
			ТОГДА 0
		КОГДА СправочникОшибки.СрочностьИсправления = ЗНАЧЕНИЕ(Перечисление.СрочностьИсправленияОшибок.ЖелательноБыстрее)
			ТОГДА 1
		КОГДА СправочникОшибки.СрочностьИсправления = ЗНАЧЕНИЕ(Перечисление.СрочностьИсправленияОшибок.Немедленно)
			ТОГДА 2
	КОНЕЦ,
	ВЫРАЗИТЬ(СправочникОшибки.СпособИсправления КАК СТРОКА(1000)),
	ВЫРАЗИТЬ(СправочникОшибки.ТекстПоследнегоПоручения КАК СТРОКА(1000)),
	ВЫБОР
		КОГДА СправочникОшибки.Обнаружена = ЗНАЧЕНИЕ(Перечисление.МестаОбнаруженияОшибок.ВСборке)
			ТОГДА Сборки.Ветка
		КОГДА СправочникОшибки.Обнаружена = ЗНАЧЕНИЕ(Перечисление.МестаОбнаруженияОшибок.ВВетке)
			ТОГДА СправочникОшибки.ВеткаОбнаружения
	КОНЕЦ,
	ВЫБОР
		КОГДА СправочникОшибки.Исправляется = ЗНАЧЕНИЕ(Перечисление.ВариантыИсправленияОшибок.ТолькоВВеткеОбнаружения)
			ТОГДА ВЫБОР
					КОГДА СправочникОшибки.Обнаружена = ЗНАЧЕНИЕ(Перечисление.МестаОбнаруженияОшибок.ВСборке)
						ТОГДА Сборки.Ветка
					ИНАЧЕ СправочникОшибки.ВеткаОбнаружения
				КОНЕЦ
		КОГДА СправочникОшибки.Исправляется = ЗНАЧЕНИЕ(Перечисление.ВариантыИсправленияОшибок.ТолькоВОсновнойВеткеПроекта)
			ТОГДА Ветки.Ссылка
	КОНЕЦ,
	ДАТАВРЕМЯ(1, 1, 1),
	СправочникОшибки.ВеткаИсправления,
	ВЫБОР
		КОГДА СправочникОшибки.Исправляется = ЗНАЧЕНИЕ(Перечисление.ВариантыИсправленияОшибок.ТолькоВОсновнойВеткеПроекта)
				И (СправочникОшибки.Обнаружена = ЗНАЧЕНИЕ(Перечисление.МестаОбнаруженияОшибок.ВВетке)
						И СправочникОшибки.ВеткаОбнаружения &lt;> СправочникОшибки.Владелец.Ветка
					ИЛИ СправочникОшибки.Обнаружена = ЗНАЧЕНИЕ(Перечисление.МестаОбнаруженияОшибок.ВСборке)
						И СправочникОшибки.СборкаОбнаружения.Ветка &lt;> СправочникОшибки.Владелец.Ветка)
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияИсправленияОшибок.ИсправлениеНеПланируется)
		КОГДА НЕ СправочникОшибки.Исправлена
				И НЕ СправочникОшибки.НеПризнана
				И НЕ СправочникОшибки.Отозвана
				И НЕ СправочникОшибки.НеПланируетсяИсправлять
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияИсправленияОшибок.ТребуетсяИсправление)
		КОГДА СправочникОшибки.Исправлена
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияИсправленияОшибок.Исправлена)
		КОГДА СправочникОшибки.НеПланируетсяИсправлять
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияИсправленияОшибок.ИсправлениеНеПланируется)
		КОГДА СправочникОшибки.НеПризнана
				ИЛИ СправочникОшибки.Отозвана
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияИсправленияОшибок.ОшибкиНеБылоВЭтойВетке)
	КОНЕЦ,
	СправочникОшибки.ДатаИсправления,
	ЕСТЬNULL(ВеткиИсправления.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыВеток.ПустаяСсылка)),
	ОтветственныеЗаИсправительныеВетки.Ссылка,
	ОтветственныеЗаИсправительныеВетки.Подразделение
ИЗ
	Справочник.Ошибки КАК СправочникОшибки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
		ПО (НаличиеФайлов.ОбъектСФайлами = СправочникОшибки.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СборкиВерсии КАК Сборки
		ПО (СправочникОшибки.Обнаружена = ЗНАЧЕНИЕ(Перечисление.МестаОбнаруженияОшибок.ВСборке))
			И СправочникОшибки.СборкаОбнаружения = Сборки.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Ветки КАК Ветки
		ПО СправочникОшибки.Владелец = Ветки.Владелец
			И (Ветки.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыВеток.ОсновнаяВеткаПроекта))
			И (НЕ Ветки.ПометкаУдаления)
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Ветки КАК ВеткиИсправления
		ПО СправочникОшибки.ВеткаИсправления = ВеткиИсправления.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК ОтветственныеЗаИсправительныеВетки
		ПО (ВеткиИсправления.Ответственный = ОтветственныеЗаИсправительныеВетки.Ссылка)
ГДЕ
	СправочникОшибки.Исправляется В (ЗНАЧЕНИЕ(Перечисление.ВариантыИсправленияОшибок.ТолькоВВеткеОбнаружения), ЗНАЧЕНИЕ(Перечисление.ВариантыИсправленияОшибок.ТолькоВОсновнойВеткеПроекта))</queryText>
