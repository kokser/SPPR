    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ВариантОбнаруженияОшибки</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ВерсияВоспроизведения</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.КоличествоТехПроектов</segments>
    </notDefaultUseAlwaysAttributes>
